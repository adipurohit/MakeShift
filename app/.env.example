# Copy this file to .env and fill in your real key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Models come from models.json at the repo root (shared with the website). These override it on your machine only.
# See https://ai.google.dev/gemini-api/docs/models
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_VISION_MODEL=gemini-3.8-flash
# Models to try, in order, when the main one is rate limited, overloaded or not found. Comma-separated.
# Quotas are per project AND per model, so each extra model is extra capacity. "off" disables fallbacks.
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
