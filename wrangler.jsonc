// Cloudflare Worker that serves MakeShift at adipurohit.com/makeshift.
// The route takes priority over the portfolio Worker for /makeshift paths only.
// Static files come from dist/ (built by scripts/build-web.sh). The Worker code in worker/
// answers the AI endpoints under /makeshift/api/ using the GEMINI_API_KEY secret.
// Add the secret in the dashboard: Workers & Pages > makeshift > Settings > Variables and Secrets.
{
  "name": "makeshift",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "build": { "command": "sh scripts/build-web.sh" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/makeshift/api/*"]
  },
  "routes": [
    { "pattern": "adipurohit.com/makeshift*", "zone_name": "adipurohit.com" }
  ],
  // AI rate limits. namespace_id values must be unique within the Cloudflare account.
  // AI_LIMIT: 20 calls/minute per browser session; AI_IP_LIMIT: 120 calls/minute per network.
  // The network cap limits abuse while the session cap lets a room share one Wi-Fi connection.
  "ratelimits": [
    { "name": "AI_LIMIT", "namespace_id": "4207", "simple": { "limit": 20, "period": 60 } },
    { "name": "AI_IP_LIMIT", "namespace_id": "4208", "simple": { "limit": 120, "period": 60 } }
  ],
  "workers_dev": false,
  "observability": { "enabled": true }
}
