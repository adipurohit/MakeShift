// Cloudflare Worker that serves the MakeShift web app at adipurohit.com/makeshift.
// The route below takes priority over the portfolio Worker for /makeshift paths only.
// Deploys run scripts/build-web.sh first, which copies the browser files into dist/.
{
  "name": "makeshift",
  "compatibility_date": "2026-11-01",
  "build": { "command": "sh scripts/build-web.sh" },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "adipurohit.com/makeshift*", "zone_name": "adipurohit.com" }
  ],
  "workers_dev": false
}
